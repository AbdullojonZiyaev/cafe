# Copy to .env and adjust for your deployment, then run: docker compose up -d --build

# Server-side: base URL of the menu backend API, read at request time.
# The container runs with network_mode: host (see docker-compose.yml) so it
# shares the host's network namespace and CAN use localhost here, since the
# backend (uvicorn) runs as a bare process on the same host. Replace 8000
# with uvicorn's actual port.
API_BASE_URL=http://localhost:8000/api/public

# Client-side: base URL used to resolve relative media (video/photo) URLs.
# This is baked into the browser bundle and sent to VISITORS' browsers, so it
# must be a real public domain/IP reachable from outside the server —
# NEVER localhost, even though the frontend and backend are colocated.
NEXT_PUBLIC_MEDIA_BASE_URL=https://your-public-domain.example
